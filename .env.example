# ============================================================
# Конфигурация окружения для деплоя Kafka-кластера в Yandex Cloud
# Скопируйте в .env и заполните реальными значениями:
#   cp .env.example .env && source .env
# ============================================================

# --- Публичные IP (для SSH с вашей рабочей машины) ---
# Узнать: Yandex Cloud Console → Compute Cloud → VM → Внешний IP
export KAFKA_1_PUBLIC_IP="YOUR_KAFKA_1_PUBLIC_IP"
export KAFKA_2_PUBLIC_IP="YOUR_KAFKA_2_PUBLIC_IP"
export KAFKA_3_PUBLIC_IP="YOUR_KAFKA_3_PUBLIC_IP"
export CLICKHOUSE_PUBLIC_IP=""

# --- Внутренние IP (для Kafka-трафика внутри VPC Yandex Cloud) ---
# Узнать: Yandex Cloud Console → Compute Cloud → VM → Внутренний IP
export KAFKA_1_IP="YOUR_KAFKA_1_INTERNAL_IP"
export KAFKA_2_IP="YOUR_KAFKA_2_INTERNAL_IP"
export KAFKA_3_IP="YOUR_KAFKA_3_INTERNAL_IP"
export CLICKHOUSE_IP=""

# --- SSH-ключ ---
export ANSIBLE_SSH_PRIVATE_KEY="${HOME}/.ssh/id_ed25519"

# --- Пользователь (по умолчанию ubuntu для Yandex Cloud) ---
export ANSIBLE_USER="ubuntu"

==> ВМ кластера (3 шт.):

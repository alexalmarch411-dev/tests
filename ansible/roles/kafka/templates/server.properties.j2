# {{ ansible_managed }}
# ============================================================
# Kafka Server Properties — KRaft Mode
# Generated by Ansible. Do not edit manually.
# ============================================================

# --- Node Identity ---
node.id={{ kafka_node_id }}
process.roles={{ kafka_process_roles }}

# --- KRaft Controller Quorum ---
controller.quorum.voters={{ kafka_controller_quorum_voters | trim }}

# --- Listeners ---
listeners={{ kafka_listeners | trim }}
advertised.listeners={{ kafka_advertised_listeners }}
listener.security.protocol.map={{ kafka_listener_security_protocol_map }}
inter.broker.listener.name={{ kafka_inter_broker_listener_name }}
controller.listener.names={{ kafka_controller_listener_names }}

# --- Storage ---
log.dirs={{ kafka_log_dirs }}

# --- Topic Defaults ---
num.partitions={{ kafka_num_partitions }}
default.replication.factor={{ kafka_default_replication_factor }}
min.insync.replicas={{ kafka_min_insync_replicas }}
offsets.topic.replication.factor={{ kafka_offsets_topic_replication_factor }}
transaction.state.log.replication.factor={{ kafka_transaction_state_log_replication_factor }}
transaction.state.log.min.isr={{ kafka_transaction_state_log_min_isr }}
auto.create.topics.enable={{ kafka_auto_create_topics_enable }}

# --- Log Configuration ---
log.retention.hours=168
log.retention.bytes=-1
log.segment.bytes=1073741824
log.retention.check.interval.ms=300000

# --- Network ---
num.network.threads=3
num.io.threads=8
socket.send.buffer.bytes=102400
socket.receive.buffer.bytes=102400
socket.request.max.bytes=104857600

# --- Replication ---
replica.fetch.max.bytes=1048576
replica.lag.time.max.ms=30000

# --- Group Coordinator ---
group.initial.rebalance.delay.ms=3000

# --- Performance ---
message.max.bytes=1048576
queued.max.requests=500

{% if kafka_jmx_enabled | default(true) %}
# --- JMX / Metrics ---
# JMX is configured via environment variables in Docker
{% endif %}
